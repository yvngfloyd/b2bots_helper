BOT_TOKEN=123456:replace_me
OWNER_CHAT_ID=123456789
OWNER_CHAT_IDS=5768086346
SITE_URL=https://example.com
TG_CHANNEL_URL=https://t.me/example
REQUIRE_SUBSCRIPTION=false
SUBSCRIPTION_CHANNEL_ID=@example
BOT_TITLE=B2Bots Helper
COVER_FILE_ID=
# Preferred production storage: Railway Postgres DATABASE_URL.
# If DATABASE_URL is set, it wins over DATABASE_PATH and no SQLite file is used.
DATABASE_URL=
# Local/fallback SQLite storage. Leave empty locally to use ./bot_data.sqlite3.
DATABASE_PATH=
FIRST_REMINDER_HOURS=1
REMINDER_REPEAT_DAYS=3
REMINDER_CHECK_SECONDS=300
# On Railway CRM is enabled automatically and binds to 0.0.0.0:$PORT.
# Leave these empty unless you intentionally override the defaults.
CRM_ENABLED=
CRM_HOST=
CRM_PORT=8080
CRM_USERNAME=
CRM_PASSWORD=
ADMIN_TOKEN=
